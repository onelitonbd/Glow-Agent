# Glow Agent binds only to loopback in this initial local-first release.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/glow-agent.sqlite

# Create this value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Do not commit or share the generated key. Changing it makes existing encrypted
# provider credentials unreadable.
APP_ENCRYPTION_KEY=replace-with-a-random-base64-encoded-32-byte-key
