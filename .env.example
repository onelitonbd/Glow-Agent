# Glow Agent binds only to loopback in this initial local-first release.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/glow-agent.sqlite

# Safety ceiling on tool-use rounds per assistant turn (kept high = effectively unlimited).
MAX_TOOL_ROUNDS=500
# How many times to retry a provider request after a failure, resuming any partial content.
MAX_PROVIDER_RETRIES=20
